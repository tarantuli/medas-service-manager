{
    "name": "morphp/medas-service-manager",
    "description": "Medas service manager",
    "authors": [
        {
            "name": "Patrick Morpey",
            "email": "patrick@morphp.nl"
        }
    ],
    "type": "library",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "morphp/medas-core": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "morphp/medas-config-manager": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../config-manager"
        },
        {
            "type": "path",
            "url": "../file-system"
        }
    ],
    "autoload": {
        "psr-4": {
            "Medas\\ServiceManager\\": "src/",
            "Medas\\Test\\": "tests/"
        }
    }
}
